#!/usr/bin/env python3
"""
High-Precision Mathematical Engine.
Optimized for arbitrary-precision arithmetic using Python's decimal module.
Designed for execution in terminal environments like Termux or AndroidIDE.
"""

import argparse
import random
from decimal import Decimal, getcontext


def calculate_pi_chudnovsky(digits: int) -> str:
    """Calculates Pi to the specified number of decimal places 
    using the optimized Chudnovsky recurrence algorithm.

    Args:
        digits: Number of decimal places to calculate.

    Returns:
        A string representation of Pi with the requested precision.
    """
    if digits < 0:
        raise ValueError("Digits must be a non-negative integer.")

    # Set decimal precision with a safety margin to eliminate rounding artifacts
    extra_digits = 10
    getcontext().prec = digits + extra_digits

    C = Decimal(640320)
    constant_multiplier = Decimal(13591409)
    linear_multiplier = Decimal(545140134)

    total_sum = Decimal(constant_multiplier)
    term = Decimal(constant_multiplier)

    # Each iteration of the Chudnovsky series yields roughly 14 decimal digits
    iterations = max(1, digits // 14 + 1)

    for k in range(1, iterations):
        k_dec = Decimal(k)
        prev_k = Decimal(k - 1)

        num1 = 6 * k - 5
        num2 = 6 * k - 4
        num3 = 6 * k - 3
        num4 = 6 * k - 2
        num5 = 6 * k - 1
        num6 = 6 * k

        den1 = 3 * k - 2
        den2 = 3 * k - 1
        den3 = 3 * k
        den4 = k**3

        sign = -1 if k % 2 != 0 else 1

        numerator_factor = (
            Decimal(sign)
            * Decimal(num1)
            * Decimal(num2)
            * Decimal(num3)
            * Decimal(num4)
            * Decimal(num5)
            * Decimal(num6)
            * (linear_multiplier * k_dec + constant_multiplier)
        )

        denominator_factor = (
            Decimal(den1)
            * Decimal(den2)
            * Decimal(den3)
            * Decimal(den4)
            * (C**3)
            * (linear_multiplier * prev_k + constant_multiplier)
        )

        term = term * (numerator_factor / denominator_factor)
        total_sum += term

    c_sqrt = (C * 10005).sqrt()
    scaling_factor = Decimal(4268800) * c_sqrt
    pi_value = scaling_factor / total_sum

    pi_str = str(pi_value)
    if digits == 0:
        return pi_str.split(".")[0]

    integer_part, decimal_part = pi_str.split(".")
    return f"{integer_part}.{decimal_part[:digits]}"


def calculate_sqrt(number: str, digits: int) -> str:
    """Calculates high-precision square root of a numeric string.

    Args:
        number: The target number as a string or numeric value.
        digits: Number of decimal places.

    Returns:
        String representation of the square root.
    """
    getcontext().prec = digits + 10
    dec_num = Decimal(number)
    if dec_num < 0:
        raise ValueError("Cannot calculate square root of a negative number.")
    
    result = dec_num.sqrt()
    res_str = str(result)
    if digits == 0:
        return res_str.split(".")[0]
    
    integer_part, decimal_part = res_str.split(".")
    return f"{integer_part}.{decimal_part[:digits]}"


def estimate_pi_monte_carlo(samples: int) -> float:
    """Estimates Pi using a Monte Carlo statistical simulation.

    Args:
        samples: Number of random coordinate pairs generated.

    Returns:
        Estimated float value of Pi.
    """
    inside_circle = 0
    for _ in range(samples):
        x = random.random()
        y = random.random()
        if x**2 + y**2 <= 1.0:
            inside_circle += 1
    return 4.0 * inside_circle / samples


def main():
    parser = argparse.ArgumentParser(
        description="High-Precision Mathematical Engine for Termux and AndroidIDE."
    )
    subparsers = parser.add_subparsers(dest="command", help="Available mathematical operations")

    # Command: pi
    parser_pi = subparsers.add_parser("pi", help="Calculate Pi using Chudnovsky algorithm")
    parser_pi.add_argument("-d", "--digits", type=int, default=100, help="Number of decimal places (default: 100)")

    # Command: sqrt
    parser_sqrt = subparsers.add_parser("sqrt", help="Calculate high-precision square root")
    parser_sqrt.add_argument("number", type=str, help="Number to evaluate")
    parser_sqrt.add_argument("-d", "--digits", type=int, default=50, help="Number of decimal places (default: 50)")

    # Command: monte-carlo
    parser_mc = subparsers.add_parser("monte-carlo", help="Estimate Pi via Monte Carlo simulation")
    parser_mc.add_argument("-s", "--samples", type=int, default=1000000, help="Number of sample points (default: 1000000)")

    args = parser.parse_args()

    if args.command == "pi":
        print(f"Calculando Pi com {args.digits} casas decimais...")
        result = calculate_pi(args.digits)
        print(f"\nResultado:\n{result}")
    elif args.command == "sqrt":
        print(f"Calculando raiz quadrada de {args.number} com {args.digits} casas...")
        result = calculate_sqrt(args.number, args.digits)
        print(f"\nResultado:\n{result}")
    elif args.command == "monte-carlo":
        print(f"Executando simulação de Monte Carlo com {args.samples} amostras...")
        result = estimate_pi_monte_carlo(args.samples)
        print(f"\nEstimativa de Pi: {result}")
    else:
        parser.print_help()


