
#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
HIGH-PRECISION MATHEMATICAL ENGINE
Version: 2.0
Python: 3.9+
Platforms: Termux, AndroidIDE, Linux, Windows

Features:
- Pi calculation using Chudnovsky + Binary Splitting.
- Arbitrary-precision square root using Decimal.
- Monte Carlo Pi estimation.
- Isolated decimal contexts.
- Correct decimal rounding.
- Input validation and exception handling.
- Integrated automated tests.
- No external dependencies.
"""

import argparse
import random
import sys
import unittest

from decimal import (
    Decimal,
    localcontext,
    InvalidOperation,
    DecimalException,
)


# ============================================================
# CONFIGURATION
# ============================================================

VERSION = "2.0"

CHUDNOVSKY_A = 13591409
CHUDNOVSKY_B = 545140134
CHUDNOVSKY_C = 640320

CHUDNOVSKY_C3_OVER_24 = CHUDNOVSKY_C**3 // 24

GUARD_DIGITS = 25


# ============================================================
# VALIDATION
# ============================================================

def validate_digits(digits: int) -> None:
    if isinstance(digits, bool) or not isinstance(digits, int):
        raise ValueError("Digits must be an integer.")

    if digits < 0:
        raise ValueError("Digits cannot be negative.")


def validate_samples(samples: int) -> None:
    if isinstance(samples, bool) or not isinstance(samples, int):
        raise ValueError("Samples must be an integer.")

    if samples <= 0:
        raise ValueError("Samples must be greater than zero.")


# ============================================================
# CHUDNOVSKY: BINARY SPLITTING
# ============================================================

def binary_split(a: int, b: int):
    """
    Calculates the Chudnovsky series using Binary Splitting.

    Returns:
        P, Q, T

    Uses exact integer arithmetic, avoiding intermediate
    Decimal rounding during the series calculation.
    """

    if b <= a:
        raise ValueError("Invalid binary splitting interval.")

    if b - a == 1:

        if a == 0:
            return 1, 1, CHUDNOVSKY_A

        P = (
            (6 * a - 5)
            * (2 * a - 1)
            * (6 * a - 1)
        )

        Q = (
            a**3
            * CHUDNOVSKY_C3_OVER_24
        )

        T = P * (
            CHUDNOVSKY_A
            + CHUDNOVSKY_B * a
        )

        if a % 2:
            T = -T

        return P, Q, T

    midpoint = (a + b) // 2

    P1, Q1, T1 = binary_split(a, midpoint)
    P2, Q2, T2 = binary_split(midpoint, b)

    P = P1 * P2
    Q = Q1 * Q2
    T = T1 * Q2 + P1 * T2

    return P, Q, T


# ============================================================
# PI: HIGH PRECISION
# ============================================================

def calculate_pi_chudnovsky(digits: int = 100) -> str:
    """
    Calculates Pi using Chudnovsky and Binary Splitting.

    Each term provides approximately 14 decimal digits.

    Returns a string rounded to the requested decimal places.
    """

    validate_digits(digits)

    iterations = digits // 14 + 2

    P, Q, T = binary_split(0, iterations)

    with localcontext() as ctx:

        ctx.prec = digits + GUARD_DIGITS

        sqrt_10005 = Decimal(10005).sqrt()

        numerator = (
            Decimal(Q)
            * Decimal(426880)
            * sqrt_10005
        )

        pi_value = numerator / Decimal(T)

        rounding_unit = Decimal(1).scaleb(-digits)

        pi_value = pi_value.quantize(rounding_unit)

        return f"{pi_value:.{digits}f}"


# ============================================================
# SQUARE ROOT: HIGH PRECISION
# ============================================================

def calculate_sqrt(number: str, digits: int = 50) -> str:
    """
    Calculates the square root using Python Decimal.

    Supports arbitrary decimal input and proper rounding.
    """

    validate_digits(digits)

    try:
        dec_number = Decimal(str(number))

    except (InvalidOperation, ValueError):
        raise ValueError("Invalid numeric input.")

    if not dec_number.is_finite():
        raise ValueError("Number must be finite.")

    if dec_number < 0:
        raise ValueError("Cannot calculate square root of a negative number.")

    integer_digits = max(
        1,
        dec_number.adjusted() // 2 + 2
    ) if dec_number != 0 else 1

    precision = integer_digits + digits + GUARD_DIGITS

    with localcontext() as ctx:

        ctx.prec = precision

        result = dec_number.sqrt()

        rounding_unit = Decimal(1).scaleb(-digits)

        result = result.quantize(rounding_unit)

        return f"{result:.{digits}f}"


# ============================================================
# MONTE CARLO: PI ESTIMATION
# ============================================================

def estimate_pi_monte_carlo(
    samples: int = 1_000_000,
    seed=None
) -> float:
    """
    Estimates Pi using Monte Carlo simulation.

    Uses an optional seed for reproducible simulations.
    Processes samples incrementally without storing coordinates.
    """

    validate_samples(samples)

    rng = random.Random(seed)

    inside_circle = 0

    for _ in range(samples):

        x = rng.random()
        y = rng.random()

        if x * x + y * y <= 1.0:
            inside_circle += 1

    return 4.0 * inside_circle / samples


# ============================================================
# AUTOMATED TESTS
# ============================================================

class MathematicalEngineTests(unittest.TestCase):

    def test_pi_zero_digits(self):
        self.assertEqual(
            calculate_pi_chudnovsky(0),
            "3"
        )

    def test_pi_precision(self):
        self.assertEqual(
            calculate_pi_chudnovsky(10),
            "3.1415926536"
        )

    def test_pi_high_precision(self):
        result = calculate_pi_chudnovsky(50)

        self.assertEqual(
            result,
            "3.14159265358979323846264338327950288419716939937511"
        )

    def test_sqrt_two(self):
        self.assertEqual(
            calculate_sqrt("2", 10),
            "1.4142135624"
        )

    def test_sqrt_zero(self):
        self.assertEqual(
            calculate_sqrt("0", 5),
            "0.00000"
        )

    def test_sqrt_rounding(self):
        self.assertEqual(
            calculate_sqrt("2", 2),
            "1.41"
        )

    def test_negative_sqrt(self):
        with self.assertRaises(ValueError):
            calculate_sqrt("-4", 10)

    def test_invalid_pi_digits(self):
        with self.assertRaises(ValueError):
            calculate_pi_chudnovsky(-1)

    def test_invalid_samples(self):
        with self.assertRaises(ValueError):
            estimate_pi_monte_carlo(0)

    def test_monte_carlo_seed(self):
        result1 = estimate_pi_monte_carlo(1000, seed=42)
        result2 = estimate_pi_monte_carlo(1000, seed=42)

        self.assertEqual(result1, result2)


# ============================================================
# COMMAND LINE INTERFACE
# ============================================================

def main():

    parser = argparse.ArgumentParser(
        prog="math_engine",
        description=(
            "High-Precision Mathematical Engine "
            "for Termux and AndroidIDE."
        )
    )

    parser.add_argument(
        "--version",
        action="version",
        version=f"Math Engine {VERSION}"
    )

    subparsers = parser.add_subparsers(
        dest="command",
        help="Available mathematical operations"
    )

    # --------------------------------------------------------
    # PI COMMAND
    # --------------------------------------------------------

    parser_pi = subparsers.add_parser(
        "pi",
        help="Calculate Pi using Chudnovsky"
    )

    parser_pi.add_argument(
        "-d",
        "--digits",
        type=int,
        default=100,
        help="Decimal places (default: 100)"
    )

    # --------------------------------------------------------
    # SQRT COMMAND
    # --------------------------------------------------------

    parser_sqrt = subparsers.add_parser(
        "sqrt",
        help="Calculate high-precision square root"
    )

    parser_sqrt.add_argument(
        "number",
        type=str,
        help="Number to evaluate"
    )

    parser_sqrt.add_argument(
        "-d",
        "--digits",
        type=int,
        default=50,
        help="Decimal places (default: 50)"
    )

    # --------------------------------------------------------
    # MONTE CARLO COMMAND
    # --------------------------------------------------------

    parser_mc = subparsers.add_parser(
        "monte-carlo",
        help="Estimate Pi using Monte Carlo"
    )

    parser_mc.add_argument(
        "-s",
        "--samples",
        type=int,
        default=1_000_000,
        help="Number of samples"
    )

    parser_mc.add_argument(
        "--seed",
        type=int,
        default=None,
        help="Random seed for reproducibility"
    )

    # --------------------------------------------------------
    # TEST COMMAND
    # --------------------------------------------------------

    subparsers.add_parser(
        "test",
        help="Run automated mathematical tests"
    )

    args = parser.parse_args()

    try:

        if args.command == "pi":

            print(
                f"Calculating Pi with {args.digits} decimal places..."
            )

            result = calculate_pi_chudnovsky(args.digits)

            print("\nResult:")
            print(result)

        elif args.command == "sqrt":

            print(
                f"Calculating sqrt({args.number}) "
                f"with {args.digits} decimal places..."
            )

            result = calculate_sqrt(
                args.number,
                args.digits
            )

            print("\nResult:")
            print(result)

        elif args.command == "monte-carlo":

            print(
                f"Running Monte Carlo with "
                f"{args.samples:,} samples..."
            )

            result = estimate_pi_monte_carlo(
                args.samples,
                seed=args.seed
            )

            print("\nPi estimation:")
            print(f"{result:.15f}")

        elif args.command == "test":

            print("Running mathematical engine tests...\n")

            suite = unittest.defaultTestLoader.loadTestsFromTestCase(
                MathematicalEngineTests
            )

            runner = unittest.TextTestRunner(verbosity=2)

            result = runner.run(suite)

            if not result.wasSuccessful():
                sys.exit(1)

        else:

            parser.print_help()

    except (
        ValueError,
        InvalidOperation,
        DecimalException,
        ArithmeticError,
        RecursionError
    ) as error:

        print(
            f"\nError: {error}",
            file=sys.stderr
        )

        sys.exit(1)


# ============================================================
# ENTRY POINT
# ============================================================

if __name__ == "__main__":
    main()
